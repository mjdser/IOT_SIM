{
  "intent": "A keyboard for typing English letters is shown.",
  "theme": "dark",
  "visual_rubric": [
    "The screen has a dark background.",
    "At the top, there is an input box showing the typed text.",
    "Below the input, a QWERTY keyboard is present.",
    "Keys include Q to P, A to L, Z to M, a Space and a Back key.",
    "Each key is in a dark button with light text.",
    "At the bottom, it says 'English Keyboard'."
  ],
  "tests": [
    {
      "name": "enter a word",
      "steps": [
        {
          "capture": {
            "label": "blank",
            "expect_visual": [
              "The input box is empty."
            ]
          }
        },
        {
          "tap": "key_h"
        },
        {
          "tap": "key_e"
        },
        {
          "tap": "key_l"
        },
        {
          "tap": "key_l"
        },
        {
          "tap": "key_o"
        },
        {
          "expect": {
            "lbl_input": {
              "text": "HELLO"
            }
          }
        },
        {
          "capture": {
            "label": "typed_hello",
            "expect_visual": [
              "The input box shows HELLO.",
              "'H','E','L','L','O' keys were tapped."
            ]
          }
        }
      ]
    },
    {
      "name": "space bar",
      "steps": [
        {
          "tap": "key_h"
        },
        {
          "tap": "key_e"
        },
        {
          "tap": "key_l"
        },
        {
          "tap": "key_l"
        },
        {
          "tap": "key_o"
        },
        {
          "tap": "key_space"
        },
        {
          "tap": "key_w"
        },
        {
          "tap": "key_o"
        },
        {
          "tap": "key_r"
        },
        {
          "tap": "key_l"
        },
        {
          "tap": "key_d"
        },
        {
          "expect": {
            "lbl_input": {
              "text": "HELLO WORLD"
            }
          }
        },
        {
          "capture": {
            "label": "typed_hello_world",
            "expect_visual": [
              "The input box shows HELLO WORLD.",
              "Space was inserted after HELLO."
            ]
          }
        }
      ]
    },
    {
      "name": "backspace removes a letter",
      "steps": [
        {
          "tap": "key_h"
        },
        {
          "tap": "key_i"
        },
        {
          "tap": "key_back"
        },
        {
          "expect": {
            "lbl_input": {
              "text": "H"
            }
          }
        },
        {
          "capture": {
            "label": "after_backspace",
            "expect_visual": [
              "The input box shows H."
            ]
          }
        }
      ]
    },
    {
      "name": "fill and clear input",
      "steps": [
        {
          "tap": "key_z"
        },
        {
          "tap": "key_x"
        },
        {
          "tap": "key_c"
        },
        {
          "tap": "key_v"
        },
        {
          "tap": "key_b"
        },
        {
          "tap": "key_n"
        },
        {
          "tap": "key_m"
        },
        {
          "expect": {
            "lbl_input": {
              "text": "ZXCVBNM"
            }
          }
        },
        {
          "capture": {
            "label": "typed_7",
            "expect_visual": [
              "Input shows ZXCVBNM."
            ]
          }
        },
        {
          "tap": "key_back"
        },
        {
          "tap": "key_back"
        },
        {
          "tap": "key_back"
        },
        {
          "tap": "key_back"
        },
        {
          "tap": "key_back"
        },
        {
          "tap": "key_back"
        },
        {
          "tap": "key_back"
        },
        {
          "expect": {
            "lbl_input": {
              "text": ""
            }
          }
        },
        {
          "capture": {
            "label": "cleared",
            "expect_visual": [
              "Input is empty after multiple BACK presses."
            ]
          }
        }
      ]
    }
  ]
}