{
  "intent": "Wheel balancing touchscreen workflow for car garage demo",
  "theme": "light",
  "visual_rubric": [
    "A clean light theme with wheel selection buttons A and B at top",
    "Mount and Guard toggle switches",
    "Start Measurement button and state indicator label"
  ],
  "tests": [
    {
      "name": "measure and balance inner side",
      "steps": [
        {
          "capture": {
            "label": "initial_setup",
            "expect_visual": ["Wheel A is selected", "Mount and Guard switches are off", "State reads Ready to Measure"]
          }
        },
        {"tap": "sw_mount"},
        {"tap": "sw_guard"},
        {"tap": "btn_measure"},
        {
          "capture": {
            "label": "measuring",
            "expect_visual": ["State reads Measuring Wheel...", "Finish button is visible"]
          }
        },
        {"tap": "btn_finish"},
        {"expect": {"lbl_state": {"text": "State: Results & Correction"}, "lbl_target": {"text": "Inner: 20g @ 90 deg"}}},
        {"tap": "sw_guard"},
        {"drag": ["sld_corr_wt", 20]},
        {"drag": ["sld_corr_ang", 90]},
        {"expect": {"lbl_eval": {"text": "Balanced"}}},
        {
          "capture": {
            "label": "inner_balanced",
            "expect_visual": ["Evaluation reads Balanced", "Weight is 20 g", "Angle is 90 deg"]
          }
        },
        {"tap": "sw_guard"},
        {"tap": "btn_measure"},
        {"tap": "btn_finish"},
        {"expect": {"lbl_eval": {"text": "Balanced"}}}
      ]
    },
    {
      "name": "balance outer side and view preservation",
      "steps": [
        {"tap": "sw_mount"},
        {"tap": "sw_guard"},
        {"tap": "btn_measure"},
        {"tap": "btn_finish"},
        {"tap": "tab_outer"},
        {"expect": {"lbl_target": {"text": "Outer: 35g @ 240 deg"}}},
        {"tap": "sw_guard"},
        {"drag": ["sld_corr_wt", 35]},
        {"drag": ["sld_corr_ang", 240]},
        {"expect": {"lbl_eval": {"text": "Balanced"}}},
        {"tap": "tab_inner"},
        {"tap": "tab_outer"},
        {"expect": {"lbl_eval": {"text": "Balanced"}, "lbl_corr_wt": {"text": "Weight: 35 g"}}}
      ]
    },
    {
      "name": "abort measurement on guard open",
      "steps": [
        {"tap": "sw_mount"},
        {"tap": "sw_guard"},
        {"tap": "btn_measure"},
        {"expect": {"lbl_state": {"text": "State: Measuring Wheel..."}}},
        {"tap": "sw_guard"},
        {"expect": {"lbl_state": {"text": "State: Ready to Measure"}, "sw_guard": {"checked": false}, "btn_finish": {"disabled": true}}},
        {"tap": "btn_finish"},
        {"expect": {"lbl_state": {"text": "State: Ready to Measure"}}}
      ]
    },
    {
      "name": "switch profile clears state",
      "steps": [
        {"tap": "sw_mount"},
        {"tap": "sw_guard"},
        {"tap": "btn_measure"},
        {"tap": "btn_finish"},
        {"expect": {"lbl_target": {"text": "Inner: 20g @ 90 deg"}}},
        {"tap": "btn_wheel_b"},
        {"expect": {"lbl_state": {"text": "State: Ready to Measure"}}},
        {"tap": "btn_measure"},
        {"tap": "btn_finish"},
        {"expect": {"lbl_target": {"text": "Inner: 15g @ 180 deg"}}}
      ]
    }
  ]
}