# Copy this file to ".env" (same folder) and fill in your key. ".env" is git-ignored.
GEMINI_API_KEY=
# Safe desktop default: generate, compile, and test on the PC. No board required.
FLASH=0
TESTS=1
GEMINI_MODEL=gemini-3.8-flash
# Pin fallback to the same model so a quota error cannot select a different model.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Gemini 3 code generation can exceed the previous 120-second timeout.
GEMINI_REQUEST_TIMEOUT=300
GEMINI_THINKING_LEVEL=low
# UPLOAD_PORT=COM4

# --- Automatic tests on the board (server.py / generate.py --test) ---
# TESTS=0                  # board mode only; host mode always runs its tests
# Camera that sees the screen; find it with: python tools/ui_generator/camera_check.py
# Without CAMERA_INDEX the tests still run, but without photos.
# CAMERA_INDEX=1
# CAMERA_CROP=400,120,480,560   # optional x,y,w,h in camera pixels: just the screen
# CAMERA_ROTATE=0               # optional 0/90/180/270, clockwise
# CAMERA_RESOLUTION=1600x1200  # 4:3 sees more than 16:9; CAMERA_CROP is in these pixels
# GEMINI_JUDGE_MODEL=gemini-3.8-flash   # optional separate model for the photo checks
# GEMINI_JUDGE_API_KEY=          # separate (e.g. paid) key for the photo checks; defaults to GEMINI_API_KEY
# GEMINI_JUDGE_FALLBACK_MODEL=   # optional second judge model; none by default with a separate key

# --- Which AI writes the UI and its tests ---
GENERATOR_PROVIDER=gemini     # or openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Finished simulator view; tests use the selected palette.
UI_PRESENTATION_THEME=light

# Review actual framebuffer PNGs; no physical camera.
SIM_VISION_JUDGE=1
SIM_JUDGE_PROVIDER=gemini
OPENAI_JUDGE_MODEL=gpt-4.1
# OPENAI_JUDGE_API_KEY= # optional; defaults to OPENAI_API_KEY

# Test/display requested palette only; set both for an explicit two-palette check.
SIM_TEST_PALETTES=selected
